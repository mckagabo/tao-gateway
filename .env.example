# observe: forward everything untouched and only log what would be refused.  enforce: apply the rules.
MODE=observe
# With MODE=enforce: the TAO logins the rules apply to, comma-separated. "*" means everyone.
ENFORCE_LOGINS=
ADMIN_LOGINS=taoAdmin

UPSTREAM_HOST=tao-ce-tao-1
UPSTREAM_PORT=443
PUBLIC_HOST=assessment.topbrainer.com
LOCAL_NAMESPACE=https://communityedition.tao/ontologies/tao.rdf#

# A read-only database user made for the gateway (see README). Never the postgres superuser.
DATABASE_URL=postgres://tao_gateway_ro:CHANGE_ME@pgsql:5432/postgres

# Optional: log every request of these logins (method, path, status, size), comma-separated. Leave empty normally.
TRACE_LOGINS=
